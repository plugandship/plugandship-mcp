{
  "name": "plugandship-mcp",
  "version": "0.1.0",
  "description": "MCP server for Plug and Ship: search MCP servers, agent skills and coding-agent plugins from your agent.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": { "plugandship-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

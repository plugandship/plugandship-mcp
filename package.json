{
  "name": "plugandship-mcp",
  "version": "0.2.0",
  "description": "MCP server for Plug and Ship: search MCP servers, agent skills and coding-agent plugins from your agent.",
  "mcpName": "dev.plugandship/plugandship-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "plugandship-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugandship/plugandship-mcp.git"
  },
  "homepage": "https://plugandship.dev/developers",
  "bugs": {
    "url": "https://github.com/plugandship/plugandship-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "plugandship"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "npm run build && node --test test/e2e.test.mjs",
    "prepublishOnly": "npm run build",
    "test:remote": "node --test test/remote.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
